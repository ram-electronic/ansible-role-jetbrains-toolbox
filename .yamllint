extends: default

rules:
  line-length:
    max: 120
  document-start: disable
  truthy:
    check-keys: false  # "on:" in GitHub workflows
  comments:
    min-spaces-from-content: 1
  # Required by ansible-lint (its fix mode)
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
